# ─── Banco ─────────────────────────────────────────────────
# app_user: RLS on (toda query da aplicação)
DATABASE_URL="postgresql://app_user:senha@localhost:5432/barbearia"
# app_migrator: bypass RLS (apenas Prisma Migrate)
DIRECT_URL="postgresql://app_migrator:senha@localhost:5432/barbearia"

# ─── Auth ──────────────────────────────────────────────────
# gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Server Actions (CRÍTICO em prod) ──────────────────────
# Sem essa key, Next.js gera IDs randomicos pras Server Actions
# a cada build. Resultado: cliente com pagina cacheada (PWA) chama
# action com ID antigo apos novo deploy → 404 "UnrecognizedActionError".
# Setar UMA vez e nunca mudar (igual NEXTAUTH_SECRET).
# Gere com: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Google OAuth (opcional em dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email ─────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# ─── WhatsApp (Evolution API) ──────────────────────────────
# Canal único de mensagens da app:
#   - OTP de confirmação no agendamento anônimo (PBI-23)
#   - Lembrete 24h antes do agendamento
#
# Setup no Railway:
#  1. Deploy do template "Evolution API" (inclui Redis + Postgres).
#  2. Copie AUTHENTICATION_API_KEY do service evolution-api.
#  3. Crie a instância (1x só) via:
#       curl -X POST "$EVOLUTION_API_URL/instance/create" \
#         -H "apikey: $EVOLUTION_API_KEY" \
#         -H "Content-Type: application/json" \
#         -d '{"instanceName":"barbearia","qrcode":true,"integration":"WHATSAPP-BAILEYS"}'
#  4. Escaneie o QR code com o WhatsApp do dono da barbearia
#     (abre via /instance/connect/barbearia ou no painel manager).
#
# Em dev, se vazias o sistema usa FakeWhatsAppProvider que loga
# a mensagem no console. Em produção sem essas vars o app crasha
# ao tentar mandar OTP ou lembrete.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="barbearia"

# ─── Cron (notificações diárias) ───────────────────────────
# Bearer secret pro endpoint /api/cron/daily-notifications.
# Gere com: openssl rand -base64 32
# Setup cron externo (Railway scheduled task ou cron-job.org):
#   POST /api/cron/daily-notifications
#   Header: Authorization: Bearer ${CRON_SECRET}
# Sugestão: 1x/dia às 09:00 BRT.
# Opcional se você plugou self-trigger no admin layout (commit
# feat/notifications-self-trigger): o app dispara sozinho quando
# admin abre painel.
CRON_SECRET=""

# ─── Upload de imagens — Cloudinary (vitrine, profissionais, feed) ─
# Free 25GB. Crie conta em cloudinary.com → Dashboard tem as 3 chaves.
# Se vazias, UI esconde botão de upload e cai pro campo "colar URL".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Mesmo nome do CLOUDINARY_CLOUD_NAME, exposto no client pra montar URLs
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Sentry (PBI-53: Observabilidade) ──────────────────────
# Sem SENTRY_DSN, init() é no-op — erros vão pro console como antes.
# Em prod, configurar é OBRIGATÓRIO pra ter visibilidade de incidentes.
#
# Setup:
#   1. Conta em sentry.io (free 5k events/mês)
#   2. Create new project → Next.js → copiar DSN
#   3. SENTRY_DSN: usado em server (route handlers + actions)
#   4. NEXT_PUBLIC_SENTRY_DSN: usado no browser. Mesmo valor do DSN
#      do server — Sentry filtra por origem.
#   5. SENTRY_AUTH_TOKEN: pra upload de source maps no CI. User Settings
#      → Auth Tokens → criar token com scope project:write
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Tag pra distinguir deploys no dashboard (preview / production / staging).
# Default: NODE_ENV.
SENTRY_ENV=""
NEXT_PUBLIC_SENTRY_ENV=""
# Release ID injetado em runtime. Geralmente o git SHA. Auto-detectado em
# Vercel via VERCEL_GIT_COMMIT_SHA — esta var só é necessária em CI próprio.
SENTRY_RELEASE=""

# ─── Stripe (PBI-52: Billing/Assinatura) ───────────────────
# Sem essas vars o painel /admin/* fica liberado pra todos (dev mode).
# Em produção é OBRIGATÓRIO setar — bloqueio de billing depende disso.
#
# Setup:
#   1. Conta em stripe.com → dashboard.stripe.com/test (test mode)
#   2. Developers → API keys → copiar Secret Key (sk_test_...)
#   3. Catalog → criar produto "Lustro Pro" + price R$ 49/mês recurring
#   4. Copiar Price ID (price_...) pra STRIPE_PRICE_ID
#   5. Webhooks → adicionar endpoint local via Stripe CLI:
#        stripe listen --forward-to localhost:3000/api/stripe/webhook
#      Copiar o whsec_... que aparece pra STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# ─── App ───────────────────────────────────────────────────
APP_TIMEZONE="America/Sao_Paulo"
# URL base pública (usada em emails de reset, links de checkout, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Feature flags temporarias ─────────────────────────────
# Se "1", desativa o envio de OTP por WhatsApp no fluxo /agendar/confirmar
# — cliente clica "Confirmar agendamento" e o Appointment eh criado
# direto (sem verificar codigo). Usado quando a Evolution API esta
# indisponivel ou em testes locais sem WhatsApp real.
#
# NEXT_PUBLIC_* precisa embutir no client (pra copy do botao/checkbox).
# BOOKING_OTP_DISABLED tambem serve (fallback puramente server) — server
# checa os DOIS: se qualquer estiver "1", pula OTP.
#
# Padrao (vazio) = OTP ligado normal.
NEXT_PUBLIC_BOOKING_OTP_DISABLED=""
BOOKING_OTP_DISABLED=""
