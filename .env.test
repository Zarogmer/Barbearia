# Ambiente de testes — usado por vitest integration tests.
# Postgres dedicado em localhost:5433 (docker-compose.test.yml).
# NÃO commite credentials reais aqui — esse arquivo é só placeholder.
DATABASE_URL="postgresql://postgres:test@localhost:5433/barbearia_test?schema=public"
DIRECT_URL="postgresql://postgres:test@localhost:5433/barbearia_test?schema=public"
# Senha do role app_user (criado por prisma/setup-app-user.ts). Mesma do CI
# pra paridade — o DB de teste sobe e morre no mesmo job, não é segredo.
APP_USER_PASSWORD="ci_app_user_password_not_secret"
NEXTAUTH_SECRET="test-secret-only-for-tests"
NEXTAUTH_URL="http://localhost:3000"
