// Barbearia SaaS — schema multi-tenant com RLS no Postgres.
// Fonte de verdade: docs/03-modelo-dados.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenancy ──────────────────────────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  timezone  String   @default("America/Sao_Paulo")
  allowGuestBooking Boolean @default(true)
  // PBI-26: vitrine pública
  coverImageUrl String?
  tagline       String?
  address       String?
  instagram     String?
  whatsapp      String?
  businessHours Json?
  // PBI-30: tema persistido por org. Cookie ainda sobrescreve (preview).
  theme         String?
  darkMode      Boolean @default(false)
  // PBI-44: cores customizadas dos appointments por status na agenda.
  // Shape: { confirmed: "#hex", completed: "#hex", cancelled: "#hex", noShow: "#hex" }
  // Null = usa defaults do tema.
  appointmentColors Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  services           Service[]
  professionals      Professional[]
  appointments       Appointment[]
  reviews            Review[]
  posts              Post[]
  customerNotes      CustomerNote[]
  comandas           Comanda[]
  commissionRules    CommissionRule[]
  commissionPayments CommissionPayment[]
  products           Product[]
  inventoryMovements InventoryMovement[]

  @@map("organizations")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships  Membership[]
  appointments Appointment[]
  accounts     Account[]
  sessions     Session[]

  @@map("users")
}

enum MembershipRole {
  OWNER
  STAFF
}

model Membership {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole
  professionalId String?        @unique @db.Uuid
  createdAt      DateTime       @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ─── Domínio ──────────────────────────────────────────────

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professionalServices ProfessionalService[]
  appointments         Appointment[]

  @@index([organizationId, active])
  @@map("services")
}

model Professional {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  bio            String?
  photoUrl       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership           Membership?
  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  professionalServices ProfessionalService[]
  appointments         Appointment[]
  comandas             Comanda[]
  commissionRules      CommissionRule[]
  commissionPayments   CommissionPayment[]

  @@index([organizationId, active])
  @@map("professionals")
}

model ProfessionalService {
  professionalId String @db.Uuid
  serviceId      String @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model WorkingHours {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  professionalId String  @db.Uuid
  weekday        Weekday
  startMinute    Int
  endMinute      Int

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday, startMinute])
  @@index([organizationId])
  @@map("working_hours")
}

model TimeBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  professionalId String   @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([organizationId, professionalId, startsAt])
  @@map("time_blocks")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  professionalId String            @db.Uuid
  serviceId      String            @db.Uuid
  userId         String?           @db.Uuid
  customerName   String
  customerPhone  String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(CONFIRMED)
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?
  // Notificações (job diário): marca quando o lembrete 24h foi disparado
  // pro cliente. Evita duplicar SMS se o cron rodar mais de uma vez.
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  review       Review?

  @@index([organizationId, professionalId, startsAt])
  @@index([organizationId, startsAt])
  @@index([userId, startsAt])
  @@map("appointments")
}

// ─── Cliente engagement (PBI-48 Fases 5/6) ────────────────

model Review {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  appointmentId  String   @unique @db.Uuid
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("reviews")
}

model Post {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  imageUrl       String
  caption        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("posts")
}

model CustomerNote {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @db.Uuid
  customerUserId    String   @db.Uuid
  body              String
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerUserId, createdAt])
  @@map("customer_notes")
}

// ─── Comandas (PBI-21) ────────────────────────────────────

enum ComandaStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ComandaItemType {
  SERVICE
  PRODUCT
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT
  DEBIT
  CORTESIA
}

model Comanda {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  customerUserId String?       @db.Uuid
  customerName   String
  professionalId String        @db.Uuid
  appointmentId  String?       @db.Uuid
  status         ComandaStatus @default(OPEN)
  discountCents  Int           @default(0)
  notes          String?
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional     @relation(fields: [professionalId], references: [id])
  items        ComandaItem[]
  payments     ComandaPayment[]

  @@index([organizationId, status, openedAt])
  @@index([organizationId, customerUserId])
  @@map("comandas")
}

model ComandaItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comandaId      String          @db.Uuid
  type           ComandaItemType
  refId          String?         @db.Uuid
  name           String
  quantity       Int             @default(1)
  unitPriceCents Int
  createdAt      DateTime        @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@map("comanda_items")
}

model ComandaPayment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comandaId   String        @db.Uuid
  amountCents Int
  method      PaymentMethod
  paidAt      DateTime      @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@map("comanda_payments")
}

// ─── Comissoes (PBI-22) ───────────────────────────────────

model CommissionRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  professionalId String   @db.Uuid
  serviceId      String?  @db.Uuid // null = regra default do profissional
  percent        Int      // 0-100 (inteiro)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([organizationId])
  @@map("commission_rules")
}

model CommissionPayment {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @db.Uuid
  professionalId       String   @db.Uuid
  periodStart          DateTime
  periodEnd            DateTime
  totalGrossCents      Int      // soma dos servicos atendidos no periodo
  totalCommissionCents Int      // valor pago ao profissional
  notes                String?
  paidAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([organizationId, professionalId, paidAt])
  @@map("commission_payments")
}

// ─── Estoque (PBI-18 fase 1) ──────────────────────────────
// Catalogo de produtos vendidos no balcao + historico de
// movimentacao (IN entrada, OUT saida/venda, ADJUST ajuste manual).
// Estoque atual = SUM(quantity assinada) por produto.
// Pode ficar negativo (RN: barbearia pequena vende "o que chega amanha").

enum InventoryMovementType {
  IN
  OUT
  ADJUST
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  sku            String?
  description    String?
  salePriceCents Int
  costPriceCents Int      @default(0)
  minStock       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@map("products")
}

model InventoryMovement {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  productId      String                @db.Uuid
  type           InventoryMovementType
  quantity       Int                   // sempre positivo; tipo decide se soma/subtrai
  reason         String?
  // userId opcional pra rastrear quem mexeu (NULL em movimento automatico de venda)
  userId         String?               @db.Uuid
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId, createdAt])
  @@map("inventory_movements")
}

// ─── Job runs (self-trigger de cron interno) ──────────────
// Registra cada execução do job diário de notificações pra evitar
// duplicar quando múltiplos admins abrirem o painel no mesmo dia.

model JobRun {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   // "daily-notifications"
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  result     Json?    // {remindersSent, digestsSent, ...}

  @@index([name, startedAt])
  @@map("job_runs")
}

// ─── SMS OTP (PBI-23) ─────────────────────────────────────
// Confirmacao de agendamento anonimo por codigo SMS. Cross-tenant
// (telefone e global, nao pertence a uma org). Sem RLS — controle
// de acesso e via Server Action + rate limit por phone+ip.

model OtpToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String    // E.164 normalizado (+5511999998888)
  codeHash   String    // bcrypt do codigo de 6 digitos
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_tokens")
}

// ─── NextAuth adapter ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
