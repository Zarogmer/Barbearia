// Barbearia SaaS — schema multi-tenant com RLS no Postgres.
// Fonte de verdade: docs/03-modelo-dados.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenancy ──────────────────────────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  timezone  String   @default("America/Sao_Paulo")
  allowGuestBooking Boolean @default(true)
  // PBI-26: vitrine pública
  coverImageUrl String?
  tagline       String?
  address       String?
  instagram     String?
  whatsapp      String?
  businessHours Json?
  // PBI-30: tema persistido por org. Cookie ainda sobrescreve (preview).
  theme         String?
  darkMode      Boolean @default(false)
  // PBI-44: cores customizadas dos appointments por status na agenda.
  // Shape: { confirmed: "#hex", completed: "#hex", cancelled: "#hex", noShow: "#hex" }
  // Null = usa defaults do tema.
  appointmentColors Json?
  // PBI-46: template do lembrete SMS/WhatsApp 24h antes do agendamento.
  // Aceita placeholders: {nome}, {servico}, {profissional}, {data}, {hora}, {barbearia}
  // Null = usa default em src/lib/reminder-template.ts
  reminderTemplate String?
  // PBI-43: configs de booking.
  // allowMultipleSimultaneousBookings: cliente pode ter 2 appts no mesmo
  //   horario com profs diferentes (default false: barbearia tradicional)
  // allowOverbookEncaixe: dono pode forcar agendamento em conflito de
  //   horario (encaixe). Quando false, esconde "Forcar" no QuickBooking
  allowMultipleSimultaneousBookings Boolean @default(false)
  allowOverbookEncaixe              Boolean @default(true)
  // PBI-45: taxas do cartão (basis points × 10: 4.99% = 499). Usadas
  // nos relatórios pra mostrar receita liquida apos taxa de adquirencia.
  // 0 = sem taxa configurada (default).
  creditCardFeeBp Int @default(0)
  debitCardFeeBp  Int @default(0)
  // PBI-27: cartão fidelidade. Stamps = appointments COMPLETED por cliente.
  // Ao atingir goal, cliente ganha o reward (texto livre — admin combina
  // na barbearia). loyaltyEnabled=false esconde toda UI/cálculo.
  loyaltyEnabled     Boolean @default(false)
  loyaltyGoal        Int     @default(10)
  loyaltyRewardLabel String? @default("Corte grátis")
  // PBI-49: trial de 14d setado no signup. PBI-52 (Billing) usa pra liberar
  // /admin/* enquanto trialEndsAt > now() OR subscriptionStatus=active.
  // Null = sem trial (ex: org criada via seed/admin manual).
  trialEndsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  services           Service[]
  professionals      Professional[]
  appointments       Appointment[]
  reviews            Review[]
  posts              Post[]
  customerNotes      CustomerNote[]
  comandas           Comanda[]
  commissionRules    CommissionRule[]
  commissionPayments CommissionPayment[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  customerOrgs       CustomerOrg[]
  messageTemplates   MessageTemplate[]
  packages           Package[]
  customerPackages   CustomerPackage[]
  waitlistEntries    Waitlist[]
  expenses           Expense[]
  miscRevenues       MiscRevenue[]
  customerPhotos     CustomerPhoto[]
  rooms              Room[]

  @@map("organizations")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  // PBI-28: aniversário (só mês+dia importam, mas guardamos data completa
  // pra cálculos relativos). Ano pode ser placeholder (1900) se cliente
  // não quiser revelar idade.
  birthDate       DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships  Membership[]
  appointments Appointment[]
  accounts     Account[]
  sessions     Session[]
  customerOrgs CustomerOrg[]

  @@map("users")
}

enum MembershipRole {
  OWNER
  STAFF
}

model Membership {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole
  professionalId String?        @unique @db.Uuid
  createdAt      DateTime       @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ─── Domínio ──────────────────────────────────────────────

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  // PBI-33: extras de servico.
  // category: agrupador (ex: "Corte", "Barba", "Combo")
  // color: hex pra agenda/lista (ex: "#FF5722"), null = usa tema
  // costCents: custo de produto/insumo (margem = price - cost)
  // allowOnlineBooking: se false, esconde do fluxo publico /agendar
  //   (so admin pode marcar via QuickBookingDialog)
  category           String?
  color              String?
  costCents          Int     @default(0)
  allowOnlineBooking Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professionalServices ProfessionalService[]
  appointments         Appointment[]
  packages             Package[]
  waitlistEntries      Waitlist[]

  @@index([organizationId, active])
  @@map("services")
}

model Professional {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  bio            String?
  photoUrl       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership           Membership?
  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  professionalServices ProfessionalService[]
  appointments         Appointment[]
  comandas             Comanda[]
  commissionRules      CommissionRule[]
  commissionPayments   CommissionPayment[]
  waitlistEntries      Waitlist[]

  @@index([organizationId, active])
  @@map("professionals")
}

model ProfessionalService {
  professionalId String @db.Uuid
  serviceId      String @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model WorkingHours {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  professionalId String  @db.Uuid
  weekday        Weekday
  startMinute    Int
  endMinute      Int

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday, startMinute])
  @@index([organizationId])
  @@map("working_hours")
}

model TimeBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  professionalId String   @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([organizationId, professionalId, startsAt])
  @@map("time_blocks")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  professionalId String            @db.Uuid
  serviceId      String            @db.Uuid
  userId         String?           @db.Uuid
  customerName   String
  customerPhone  String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(CONFIRMED)
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?
  // Notificações (job diário): marca quando o lembrete 24h foi disparado
  // pro cliente. Evita duplicar SMS se o cron rodar mais de uma vez.
  reminderSentAt DateTime?
  // PDV inline: forma de pagamento + paidAt quando marcar como COMPLETED
  // direto na agenda (atalho pra quem nao usa fluxo de Comanda completo).
  // Null = nao pago / status diferente de COMPLETED.
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  // PBI-41: sala/cadeira ocupada. Opcional. MVP NAO bloqueia conflito
  // por sala no slot calculator (so prof). Hook automatico fica pra v2.
  roomId         String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  review       Review?

  @@index([organizationId, professionalId, startsAt])
  @@index([organizationId, startsAt])
  @@index([userId, startsAt])
  @@map("appointments")
}

// ─── Cliente engagement (PBI-48 Fases 5/6) ────────────────

model Review {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  appointmentId  String   @unique @db.Uuid
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("reviews")
}

model Post {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  imageUrl       String
  caption        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("posts")
}

model CustomerNote {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @db.Uuid
  customerUserId    String   @db.Uuid
  body              String
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerUserId, createdAt])
  @@map("customer_notes")
}

// Tabela de "cliente da org" — link explicito User × Organization.
// User eh global (compartilhado entre orgs), CustomerOrg marca quem
// pertence a quais. Populado automaticamente em createAppointment e
// importCustomers; tambem alimentado pelo cadastro manual avulso.
//
// Sem isto, "cliente cadastrado sem agendamento" nao apareceria na
// lista (a listagem buscava por appointments.some — agora busca aqui).
model CustomerOrg {
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  source         String   @default("booking") // "booking" | "import" | "manual"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([organizationId])
  @@map("customer_orgs")
}

// ─── Comandas (PBI-21) ────────────────────────────────────

enum ComandaStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ComandaItemType {
  SERVICE
  PRODUCT
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT
  DEBIT
  CORTESIA
}

model Comanda {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  customerUserId String?       @db.Uuid
  customerName   String
  professionalId String        @db.Uuid
  appointmentId  String?       @db.Uuid
  status         ComandaStatus @default(OPEN)
  discountCents  Int           @default(0)
  notes          String?
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional     @relation(fields: [professionalId], references: [id])
  items        ComandaItem[]
  payments     ComandaPayment[]

  @@index([organizationId, status, openedAt])
  @@index([organizationId, customerUserId])
  @@map("comandas")
}

model ComandaItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comandaId      String          @db.Uuid
  type           ComandaItemType
  refId          String?         @db.Uuid
  name           String
  quantity       Int             @default(1)
  unitPriceCents Int
  createdAt      DateTime        @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@map("comanda_items")
}

model ComandaPayment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comandaId   String        @db.Uuid
  amountCents Int
  method      PaymentMethod
  paidAt      DateTime      @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@map("comanda_payments")
}

// ─── Comissoes (PBI-22) ───────────────────────────────────

model CommissionRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  professionalId String   @db.Uuid
  serviceId      String?  @db.Uuid // null = regra default do profissional
  percent        Int      // 0-100 (inteiro)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([organizationId])
  @@map("commission_rules")
}

model CommissionPayment {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @db.Uuid
  professionalId       String   @db.Uuid
  periodStart          DateTime
  periodEnd            DateTime
  totalGrossCents      Int      // soma dos servicos atendidos no periodo
  totalCommissionCents Int      // valor pago ao profissional
  notes                String?
  paidAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([organizationId, professionalId, paidAt])
  @@map("commission_payments")
}

// ─── Estoque (PBI-18 fase 1) ──────────────────────────────
// Catalogo de produtos vendidos no balcao + historico de
// movimentacao (IN entrada, OUT saida/venda, ADJUST ajuste manual).
// Estoque atual = SUM(quantity assinada) por produto.
// Pode ficar negativo (RN: barbearia pequena vende "o que chega amanha").

enum InventoryMovementType {
  IN
  OUT
  ADJUST
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  sku            String?
  description    String?
  salePriceCents Int
  costPriceCents Int      @default(0)
  minStock       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@map("products")
}

model InventoryMovement {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  productId      String                @db.Uuid
  type           InventoryMovementType
  quantity       Int                   // sempre positivo; tipo decide se soma/subtrai
  reason         String?
  // userId opcional pra rastrear quem mexeu (NULL em movimento automatico de venda)
  userId         String?               @db.Uuid
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId, createdAt])
  @@map("inventory_movements")
}

// ─── Job runs (self-trigger de cron interno) ──────────────
// Registra cada execução do job diário de notificações pra evitar
// duplicar quando múltiplos admins abrirem o painel no mesmo dia.

// Lista de espera (PBI-40). Cliente quer atender mas nao tem slot,
// admin registra preferencia. Quando libera slot (cancel/no-show),
// admin abre a tela e ve matches por servico + janela de data +
// profissional (opcional ANY).
enum WaitlistStatus {
  WAITING
  NOTIFIED
  SCHEDULED
  EXPIRED
}

model Waitlist {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @db.Uuid
  customerUserId     String?  @db.Uuid
  customerName       String
  customerPhone      String?
  serviceId          String   @db.Uuid
  professionalId     String?  @db.Uuid
  preferredDateStart DateTime @db.Date
  preferredDateEnd   DateTime @db.Date
  status             WaitlistStatus @default(WAITING)
  notifiedAt         DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, preferredDateStart])
  @@index([organizationId, serviceId, status])
  @@map("waitlist")
}

// Despesas (PBI-36). MVP simplificado: lancamentos avulsos com
// data, valor, categoria livre (string) e flag paid. Modos avancados
// (FIXED_MONTHLY recorrente, INSTALLMENT parcelado) ficam pra v2 quando
// precisar de cron — por enquanto admin lanca manualmente cada mes.
model Expense {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  amountCents    Int
  expenseDate    DateTime @db.Date
  category       String?
  notes          String?
  paid           Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expenseDate])
  @@index([organizationId, paid])
  @@map("expenses")
}

// Pacote de sessoes pre-pago (PBI-26). Cliente compra N sessoes de um
// servico adiantado por preco fixo (geralmente menor que N x preco_servico).
// Cada appointment COMPLETED desse servico pode "consumir" 1 sessao
// do saldo — admin decide no momento do pagamento.
//
// expiresInDays: NULL = nao expira; senao, expiresAt = purchasedAt + N dias
model Package {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  serviceId       String   @db.Uuid
  name            String
  sessionsCount   Int
  priceCents      Int
  expiresInDays   Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service          Service           @relation(fields: [serviceId], references: [id])
  customerPackages CustomerPackage[]

  @@index([organizationId, active])
  @@map("packages")
}

// Saldo de pacote comprado por 1 cliente. sessionsRemaining decrementa
// quando consome (>=0). Cancel de appointment que consumiu sessao deve
// estornar +1 (controle via PackageUsage ou re-execucao da regra).
model CustomerPackage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @db.Uuid
  packageId         String    @db.Uuid
  customerUserId    String    @db.Uuid
  sessionsRemaining Int
  purchasedAt       DateTime  @default(now())
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      Package      @relation(fields: [packageId], references: [id])

  @@index([organizationId, customerUserId])
  @@index([organizationId, expiresAt])
  @@map("customer_packages")
}

// Templates de mensagens (PBI-31). Dono cadastra textos prontos pra
// disparar via WhatsApp web (wa.me) — sem integracao com WhatsApp
// Cloud API (custos altos no MVP). Placeholders: {nome}, {data},
// {hora}, {servico}, {profissional}, {barbearia}, {endereco}.
//
// `key` permite seed de defaults reutilizaveis (CONFIRMAR, LEMBRETE,
// ANIVERSARIO, etc) — null/CUSTOM = template proprio.
model MessageTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  title          String
  body           String
  key            String?  // CONFIRMAR | LEMBRETE | ANIVERSARIO | SUMIDO | CUSTOM
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@map("message_templates")
}

// Lancamentos avulsos de receita (PBI-42). Venda fora de comanda
// (ex: cliente paga produto avulso sem abrir conta, dica de gorjeta,
// venda balcao rapida). Soma no relatorio financeiro junto com
// comandas fechadas. Despesas avulsas usam Expense (PBI-36).
model MiscRevenue {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  amountCents    Int
  occurredAt     DateTime @db.Date
  paymentMethod  PaymentMethod?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@map("misc_revenues")
}

// Fotos do cliente (PBI-38). Galeria de antes/depois, inspiracoes,
// portfolio do trabalho. URL aponta pra Cloudinary (mesma infra
// do cover/profissional/posts).
enum PhotoTag {
  BEFORE
  AFTER
  INSPIRATION
  OTHER
}

model CustomerPhoto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  customerUserId String   @db.Uuid
  url            String
  tag            PhotoTag @default(OTHER)
  caption        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerUserId, createdAt])
  @@map("customer_photos")
}

// Salas/cadeiras (PBI-41). Posto de trabalho fisico que pode ser
// ocupado por 1 appointment por vez. Opcional — barbearia simples
// (1 cadeira por prof) nao precisa cadastrar.
model Room {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId, active])
  @@map("rooms")
}

model JobRun {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   // "daily-notifications"
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  result     Json?    // {remindersSent, digestsSent, ...}

  @@index([name, startedAt])
  @@map("job_runs")
}

// ─── SMS OTP (PBI-23) ─────────────────────────────────────
// Confirmacao de agendamento anonimo por codigo SMS. Cross-tenant
// (telefone e global, nao pertence a uma org). Sem RLS — controle
// de acesso e via Server Action + rate limit por phone+ip.

model OtpToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String    // E.164 normalizado (+5511999998888)
  codeHash   String    // bcrypt do codigo de 6 digitos
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_tokens")
}

// ─── NextAuth adapter ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
